{
  "name": "openattacks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "start": "astro dev --host 0.0.0.0",
    "validate": "node scripts/validate.mjs && node scripts/build-simulations.mjs --check && node scripts/build-detections.mjs --check && node scripts/build-llm-exports.mjs --check",
    "check:links": "node scripts/check-source-links.mjs",
    "test:validation": "node --test tests/validation.test.mjs tests/source-links.test.mjs",
    "check": "astro check",
    "build": "npm run validate && npm run simulations:check && npm run llm:check && npm run labs:bundle && npm run skill:zip && astro build",
    "skill:zip": "node scripts/build-skill-zip.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "simulate": "node simulations/lab.mjs",
    "simulations:build": "node scripts/build-simulations.mjs",
    "simulations:check": "node scripts/build-simulations.mjs --check",
    "detections:build": "node scripts/build-detections.mjs",
    "detections:check": "node scripts/build-detections.mjs --check",
    "llm:build": "node scripts/build-llm-exports.mjs",
    "llm:check": "node scripts/build-llm-exports.mjs --check",
    "labs:bundle": "node scripts/build-lab-bundle.mjs",
    "format:data": "prettier --write \"attacks/*.yaml\" schema.yaml",
    "format:data:check": "prettier --check \"attacks/*.yaml\" schema.yaml"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "astro": "^7.4.1",
    "d3-geo": "^3.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "lighthouse": "^13.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3"
  }
}
