{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openattacks.ai/data/attacks.schema.json",
  "title": "OpenAttacksCatalogExport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "count",
    "attacks"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Deterministic UTC midnight timestamp of the latest last_reviewed or date_reported value in attacks. It is not the wall-clock time of the build, so the committed file changes only when catalog dates or records change."
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "Length of attacks."
    },
    "attacks": {
      "type": "array",
      "items": {
        "title": "OpenAttacksEntry",
        "type": "object",
        "required": [
          "id",
          "name",
          "date_reported",
          "ai_role",
          "technique_summary",
          "sources",
          "researcher",
          "org",
          "initial_access",
          "victims_and_sectors",
          "regions",
          "attribution_or_cluster",
          "scale_and_metrics",
          "prevention_angle",
          "ai_tooling_and_models",
          "other_tooling",
          "related_magicsword_projects",
          "borderline"
        ],
        "additionalProperties": false,
        "$defs": {
          "http-url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "date_reported": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?$",
            "anyOf": [
              {
                "format": "date"
              },
              {
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              }
            ]
          },
          "date_activity_start": {
            "type": [
              "string",
              "null"
            ]
          },
          "date_activity_end": {
            "type": [
              "string",
              "null"
            ]
          },
          "borderline": {
            "type": "boolean"
          },
          "borderline_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "researcher": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "$ref": "#/$defs/http-url"
                },
                "title": {
                  "type": "string"
                },
                "publisher": {
                  "type": "string"
                }
              }
            }
          },
          "magicsword_coverage": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/http-url"
            }
          },
          "ai_role": {
            "type": "string",
            "enum": [
              "ai_agent_or_mcp_as_target",
              "ai_credential_theft",
              "ai_infra_as_c2",
              "ai_tool_as_lure",
              "attacker_uses_ai_as_operator",
              "llm_generated_malware",
              "other"
            ]
          },
          "ai_role_secondary": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ai_agent_or_mcp_as_target",
              "ai_credential_theft",
              "ai_infra_as_c2",
              "ai_tool_as_lure",
              "attacker_uses_ai_as_operator",
              "llm_generated_malware",
              "other",
              null
            ]
