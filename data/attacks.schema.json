          "ai_role_detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "technique_summary": {
            "type": "string",
            "minLength": 1
          },
          "initial_access": {
            "type": "string"
          },
          "ai_tooling_and_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "frameworks": {
            "description": "Tool-page ids (tools/<id>.yaml) for offensive or testing frameworks this attack used, such as artex. Omit the field when none apply. Each id must exist, and that tool's linked_attacks must list this attack.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
