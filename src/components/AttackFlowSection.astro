---
import AttackFlow from "./AttackFlow";
import { attackFlow } from "../lib/attack-flow";
import { href, type Attack } from "../lib/catalog";
import { stageGuidance } from "../lib/stage-guidance";
const { attack } = Astro.props as { attack: Attack };
const flow = attackFlow(attack);
const guidance = Object.fromEntries(
  flow.nodes.map((node) => [node.id, stageGuidance(attack, node)]),
);
const defenseURL = href(`api/defenses/${attack.id}.json`);
---

<section
  class="attack-flow-section"
  id="attack-flow"
  aria-labelledby="attack-flow-title"
>
  <div class="flow-section-heading">
    <div>
      <h2 id="attack-flow-title">How it happened</h2>
    </div>
  </div>
  <div class="flow-frame">
    <AttackFlow
      flow={flow}
      name={attack.name}
      guidance={guidance}
      dataURL={defenseURL}
      sources={attack.sources.map((source) => source.url)}
      client:visible
    />
    <div class="flow-caption">
      <span class="flow-desktop-help">
        Select a stage · Drag to explore · + / − to zoom · Dashed edges are
        loops
      </span>
      <span class="flow-mobile-help">
        Select a stage · Arrows show reported connections
      </span>
      <span
        class:list={[
          "flow-evidence-label",
          { "is-research": attack.borderline },
        ]}
      >
        {attack.borderline
          ? "Research / qualified account"
          : "Reported sequence"}
      </span>
    </div>
  </div>
  <details class="flow-text">
    <summary>Read the flow as text & sources</summary>
    <p>
      {attack.attack_flow
        ? "A catalog reconstruction of the supplied source account."
        : "A summary diagram derived from the entry fields, not a verified detailed sequence."}{" "}
      {attack.borderline_note ||
        "Unknown steps remain explicit; an edge describes the reported relationship between steps."}
    </p>
    <ol>
      {flow.nodes.map((node, index) => (
        <li id={`flow-${node.id}`}>
          <strong>
            {String(index + 1).padStart(2, "0")} · {node.title}
          </strong>
          <p>{node.description}</p>
          <p>
            <strong>Hunt:</strong> {guidance[node.id].hypothesis}
          </p>
          <p>{guidance[node.id].limitation}</p>
          {guidance[node.id].control && (
            <p>
              <a
                href={guidance[node.id].control!.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                MagicSword policy opportunity
              </a>{" "}
              · {guidance[node.id].control!.scope}
            </p>
          )}
          <a
            href={node.source_urls[0]}
            target="_blank"
            rel="noopener noreferrer"
          >
            Source for step {index + 1}
          </a>
        </li>
      ))}
    </ol>
    {flow.edges.some((edge) => edge.loop) && (
      <p>Dashed edges show a repeated decision loop.</p>
    )}
  </details>
</section>
