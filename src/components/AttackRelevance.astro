---
import Icon from "./Icon.astro";
import { type Attack } from "../lib/catalog";
import { attackFlow } from "../lib/attack-flow";
import { applicabilityFor } from "../lib/stack-data";
import { meaningful } from "../lib/presentation";
import { stackTools, stackSystems } from "../lib/stack-matching.mjs";

const { attack } = Astro.props as { attack: Attack };
const relevance = applicabilityFor(attack);
const mapped = relevance.status === "mapped" && relevance.rules.length > 0;
const outcomes = attackFlow(attack).nodes.filter(
  (node) => node.kind === "impact" && meaningful(node.description),
);
const withoutTerminalPunctuation = (value: string) =>
  value.trim().replace(/[.!?]+$/, "");
const entryPoint = meaningful(attack.initial_access)
  ? withoutTerminalPunctuation(attack.initial_access)
  : null;
const impact = outcomes.length
  ? outcomes
      .map((node) => withoutTerminalPunctuation(node.description))
      .join("; ")
  : meaningful(attack.scale_and_metrics)
    ? withoutTerminalPunctuation(attack.scale_and_metrics)
    : "the cited report does not establish a confirmed victim outcome";
const targets = meaningful(attack.victims_and_sectors)
  ? `; reported targets include ${withoutTerminalPunctuation(attack.victims_and_sectors)}`
  : "";
const qualification = mapped
  ? ""
  : relevance.status === "attacker_tool_only"
    ? "; using the named AI products does not by itself establish exposure"
    : "; applicability to your setup has not been assessed, so verify affected versions, permissions, and configuration in the original report";
const summary = [
  entryPoint ? `Reported entry point: ${entryPoint}.` : null,
  `Reported impact: ${impact}${targets}${qualification}.`,
]
  .filter(Boolean)
  .join(" ");
---

<section class="entry-relevance" aria-labelledby="why-it-matters">
  <h2 id="why-it-matters">Why it matters</h2>
  <div class="entry-exposure">
    <p class="entry-relevance-summary">{summary}</p>
    {mapped && (
      <div class="entry-exposure-checks">
        <p class="entry-section-intro">
          Check these source-linked conditions against your setup.
        </p>
        {relevance.rules.map((rule) => (
          <div class="entry-exposure-rule">
            <div class="entry-scope-tags">
              {rule.tools.map((id) => (
                <span>
                  {stackTools.find((tool) => tool.id === id)?.label || id}
                </span>
              ))}
              {rule.systems.map((id) => (
                <span>
                  {stackSystems.find((system) => system.id === id)?.label || id}
                </span>
              ))}
              {rule.mcp && <span>MCP connection required</span>}
            </div>
            <p>{rule.reason}</p>
            {rule.conditions.length > 0 && (
              <>
                <strong class="entry-fact-label">Conditions to check</strong>
                <ul>
                  {rule.conditions.map((condition) => (
                    <li>{condition}</li>
                  ))}
                </ul>
              </>
            )}
          </div>
        ))}
        <p class="entry-editorial-note">
          Source-linked applicability guidance. Confirm current scope in the
          original report.
        </p>
      </div>
    )}
    <div class="entry-relevance-link">
      <a
        class="text-link"
        href={attack.sources[0].url}
        target="_blank"
        rel="noopener noreferrer"
      >
        Read the original report <Icon name="arrow" size={12} />
      </a>
    </div>
  </div>
</section>
