---
import { href } from "../lib/catalog";
import Icon from "./Icon.astro";
---

<section class="agent-access" aria-labelledby="agent-access-title">
  <div class="agent-access-intro">
    <span class="eyebrow accent">
      <Icon name="terminal" size={14} /> FOR AI ASSISTANTS
    </span>
    <h2 id="agent-access-title">Give your AI the evidence.</h2>
    <p>
      Start with one context file. Explore every attack, source, flow and ATLAS
      mapping without scraping the site.
    </p>
  </div>
  <div class="agent-access-resources">
    <a class="agent-file primary-agent-file" href={href("llms.txt")}>
      <Icon name="code" size={19} />
      <div>
        <strong>llms.txt</strong>
        <span>Start here · catalog guide & data links</span>
      </div>
      <Icon name="arrow" size={15} />
    </a>
    <div class="agent-file-links">
      <a href={href("llms-full.txt")}>
        Full Markdown catalog <Icon name="arrow" size={12} />
      </a>
      <a href={href("api/attacks.json")}>
        JSON API <Icon name="arrow" size={12} />
      </a>
      <a href={href("api/schema.json")}>
        Schema <Icon name="arrow" size={12} />
      </a>
    </div>
    <button
      class="copy-context-button text-link"
      data-context-url={href("llms.txt")}
    >
      Copy context URL <Icon name="plus" size={12} />
    </button>
    <span class="copy-context-status sr-only" aria-live="polite"></span>
  </div>
</section>
<script>
  const button =
    document.querySelector<HTMLButtonElement>("[data-context-url]");
  button?.addEventListener("click", async () => {
    const url = new URL(button.dataset.contextUrl!, location.origin).href;
    try {
      await navigator.clipboard.writeText(url);
      document.querySelector(".copy-context-status")!.textContent =
        "Context URL copied";
      button.textContent = "Context URL copied ✓";
    } catch {
      document.querySelector(".copy-context-status")!.textContent =
        `Copy this URL: ${url}`;
      button.textContent = url;
    }
  });
</script>
