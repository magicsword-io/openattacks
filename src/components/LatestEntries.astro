---
import { href, formatDate, type Attack } from "../lib/catalog";
import { present, evidenceTypes, environments } from "../lib/presentation";
const { attacks, total } = Astro.props as { attacks: Attack[]; total: number };
---

<section class="latest-entries" aria-labelledby="latest-title">
  <div class="section-title">
    <div>
      <span class="eyebrow">START WITH AN ATTACK PATH</span>
      <h2 id="latest-title">Recently reported</h2>
    </div>
    <a class="text-link" href={href("catalog/")}>
      Explore all {total}
    </a>
  </div>
  <ol class="latest-entry-list">
    {attacks.map((attack) => {
      const display = present(attack);
      return (
        <li data-latest-entry={attack.id}>
          <a class="latest-entry-link" href={href(`attacks/${attack.id}/`)}>
            <div>
              <h3>{display.title}</h3>
              <p>{display.summary}</p>
              <div class="latest-entry-meta">
                <span class={`evidence-badge evidence-${display.evidence}`}>
                  {evidenceTypes[display.evidence]}
                </span>
                {display.environments.filter((id) => id !== "unspecified")
                  .length > 0 && (
                  <span>
                    {display.environments
                      .filter((id) => id !== "unspecified")
                      .map((id) => environments[id])
                      .join(" · ")}
                  </span>
                )}
              </div>
            </div>
            <time datetime={attack.date_reported}>
              {formatDate(attack.date_reported)}
            </time>
          </a>
        </li>
      );
    })}
  </ol>
</section>
