---
import Icon from "./Icon.astro";

interface Props {
  id: string;
  label: string;
  title?: string;
  href: string;
  primary?: boolean;
}

const { id, label, title = label, href, primary = false } = Astro.props;
---

<a class:list={["button", { "button-primary": primary }]} href={href} data-open-dialog={id}>
  {label}
</a>
<dialog id={id} class="header-dialog" aria-labelledby={`${id}-title`}>
  <div class="dialog-heading">
    <h2 id={`${id}-title`}>{title}</h2>
    <form method="dialog">
      <button class="icon-button" type="submit" aria-label="Close dialog">
        <Icon name="close" size={18} />
      </button>
    </form>
  </div>
  <slot />
</dialog>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-open-dialog]")) {
    const dialog = document.getElementById(link.dataset.openDialog ?? "");
    if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== "function") continue;
    link.setAttribute("aria-haspopup", "dialog");
    link.addEventListener("click", (event) => {
      if (event.button || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
      event.preventDefault();
      dialog.showModal();
    });
    dialog.addEventListener("close", () => link.focus());
  }
</script>

<style>
  [data-open-dialog] {
    min-height: 44px;
    padding-inline: 0.85rem;
    font-size: 13px;
  }
  .header-dialog {
    inset-inline: 0;
    width: min(34rem, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: clamp(1rem, 4vw, 1.75rem);
    overflow: auto;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--subtle);
    border-radius: 12px;
    box-shadow: 0 1.25rem 4rem #0005;
  }
  .header-dialog::backdrop {
    background: #07090db3;
  }
  .dialog-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.35rem, 4vw, 1.85rem);
    line-height: 1.15;
  }
  .dialog-heading button {
    width: 44px;
    height: 44px;
  }
  :global(.site-header:has([data-open-dialog]) .header-actions) {
    gap: 8px;
  }
  :global(.site-header:has([data-open-dialog]) .github-link span) {
    display: none;
  }
  :global(.site-header:has([data-open-dialog]) .header-credit .magicsword-logo img) {
    width: 160px;
    height: 56px;
    object-fit: contain;
  }
  @media (min-width: 901px) {
    :global(.site-header:has([data-open-dialog]) .header-inner nav) {
      gap: clamp(10px, 1.4vw, 20px);
    }
    :global(.site-header:has([data-open-dialog]) .header-inner nav a) {
      white-space: nowrap;
    }
  }
  @media (max-width: 1250px) {
    :global(.site-header:has([data-open-dialog]) .header-credit) {
      display: none;
    }
  }
  @media (max-width: 1000px) {
    :global(.site-header:has([data-open-dialog]) .header-inner nav .nav-about) {
      display: none;
    }
  }
  @media (max-width: 650px) {
    :global(.site-header:has([data-open-dialog]) .header-actions) {
      grid-column: 1 / -1;
      grid-row: 3;
      justify-content: flex-start;
      flex-wrap: wrap;
      margin: 0 0 0.5rem;
    }
  }
</style>
