---
import { getCollection } from "astro:content";
import { roles, href, formatDate, type Attack, usedFrameworks } from "../lib/catalog";
import Icon from "./Icon.astro";
import { present } from "../lib/presentation";
const { attacks, large = false } = Astro.props as {
  attacks: Attack[];
  large?: boolean;
};
const toolNames = Object.fromEntries(
  (await getCollection("tools")).map((tool) => [tool.id, tool.data.name]),
);
const frameworkOptions = usedFrameworks(attacks)
  .map((id) => ({ id, name: toolNames[id] || id }))
  .sort((a, b) => a.name.localeCompare(b.name));
const frameworkLabel = (entry: Attack) =>
  (entry.frameworks || [])
    .map((id) => toolNames[id] || id)
    .join(", ");
const years = [
  ...new Set(attacks.map((a) => a.date_reported.slice(0, 4))),
].sort();
const groups = years.map((year) => ({
  year,
  entries: attacks
    .filter((a) => a.date_reported.startsWith(year))
    .sort((a, b) => a.ai_role.localeCompare(b.ai_role)),
}));
const chartID = large ? "timeline-overview" : "home-overview";
const chartWidth = 1000;
const plotInset = 13;
const plotWidth = chartWidth - plotInset * 2;
const yearWidth = plotWidth / years.length;
const columnGap = 14;
const columns = Math.max(
  4,
  Math.min(14, Math.floor((yearWidth - 30) / columnGap)),
);
const rowHeight = 16;
const baseline = Math.max(
  205,
  Math.ceil(
    Math.max(...groups.map((group) => group.entries.length)) / columns,
  ) *
    rowHeight +
    42,
);
const chartHeight = baseline + 49;
---

<div
  class:list={[
    "timeline-chart",
    "interactive-timeline",
    { "timeline-chart-large": large },
  ]}
  data-dot-chart
>
  <div class="chart-header">
    <span class="eyebrow">
      <span class="live-dot"></span> REPORTED ENTRIES OVER TIME
    </span>
    <div class="chart-header-actions">
      <span class="chart-period mono">
        {attacks.length} ENTRIES · {years[0]}—{years.at(-1)}
      </span>
      <button
        class="chart-motion-toggle"
        type="button"
        aria-pressed="false"
        aria-label="Pause timeline animation"
      >
        <Icon name="clock" size={13} />
        <span>Pause</span>
      </button>
    </div>
  </div>
  <svg
    class="dot-chart"
    viewBox={`0 0 ${chartWidth} ${chartHeight}`}
    role="group"
    aria-labelledby={`${chartID}-title`}
  >
    <title
      id={`${chartID}-title`}
    >Catalog entries by report year and AI role. {groups.map(g => `${g.year}: ${g.entries.length} entries`).join('. ')}. Each dot opens one catalog entry.</title>
    <defs>
      <pattern
        id={`${chartID}-grid`}
        width="16"
        height="16"
        patternUnits="userSpaceOnUse"
      >
        <circle cx="2" cy="2" r=".65" fill="currentColor" opacity=".16" />
      </pattern>
    </defs>
    <rect
      x={plotInset}
      y="10"
      width={plotWidth}
      height={baseline - 10}
      fill={`url(#${chartID}-grid)`}
    />
    {groups.map((_, index) => (
      <line
        x1={plotInset + index * yearWidth}
        y1="10"
        x2={plotInset + index * yearWidth}
        y2={baseline + 6}
        stroke="currentColor"
        opacity=".1"
      />
    ))}
    <line
      x1={plotInset}
      y1={baseline + 7}
      x2={chartWidth - plotInset}
      y2={baseline + 7}
      stroke="currentColor"
      opacity=".2"
    />
    {groups.map((group, i) => {
      const center = plotInset + (i + 0.5) * yearWidth;
      const dotStart = center - ((columns - 1) * columnGap) / 2;
      return (
        <g>
          {group.entries.map((entry, j) => (
            <a
              class="chart-entry"
              data-attack-id={entry.id}
              href={href(`attacks/${entry.id}/`)}
              aria-label={`${present(entry).title}, ${formatDate(entry.date_reported)}${frameworkLabel(entry) ? `, used ${frameworkLabel(entry)}` : ""}`}
              data-role={entry.ai_role}
              data-frameworks={JSON.stringify(entry.frameworks || [])}
              data-year={group.year}
              data-name={present(entry).title}
              data-date={formatDate(entry.date_reported)}
              style={`--dot-delay:${i * 100 + j * 22}ms;--pulse-delay:${3 + ((j * 7 + i) % 17) / 3}s`}
            >
              <g class="dot-arrival">
                <circle
                  class="attack-dot"
                  cx={dotStart + (j % columns) * columnGap}
                  cy={baseline - 12 - Math.floor(j / columns) * rowHeight}
                  r="5"
                  fill={roles[entry.ai_role].color}
                >
                  <title>{entry.name} · {roles[entry.ai_role].label}{frameworkLabel(entry) ? ` · ${frameworkLabel(entry)}` : ""}</title>
                </circle>
                {entry.frameworks?.length ? (
                  <circle
                    class="framework-ring"
                    cx={dotStart + (j % columns) * columnGap}
                    cy={baseline - 12 - Math.floor(j / columns) * rowHeight}
                    r="7.1"
                  />
                ) : null}
              </g>
            </a>
          ))}
          <text
            x={center}
            y={baseline + 34}
            fill="currentColor"
            text-anchor="middle"
            class="chart-year"
          >
            {group.year}
          </text>
          <text
            x={center}
            y={
              baseline -
              40 -
              Math.floor((group.entries.length - 1) / columns) * rowHeight
            }
            fill="currentColor"
            text-anchor="middle"
            class="chart-count"
            data-chart-year-count={group.year}
          >
            {String(group.entries.length).padStart(2, "0")}
          </text>
        </g>
      );
    })}
  </svg>
  <div class="chart-legend-heading">
    <h2>Attack categories</h2>
    <p>Select a category to highlight its reports.</p>
  </div>
  <div
    class="chart-legend"
    role="group"
    aria-label="Highlight timeline by AI role"
  >
    <button
      class="legend-button legend-all"
      aria-pressed="true"
      data-highlight=""
    >
      All roles <span class="legend-count">{attacks.length}</span>
    </button>
    {Object.entries(roles).map(([id, role]) => (
      <button
        class="legend-button"
        style={`--role-color:${role.color}`}
        data-highlight={id}
        aria-pressed="false"
      >
        <i aria-hidden="true"></i>
        {role.short}
        <span class="legend-count">
          {attacks.filter((attack) => attack.ai_role === id).length}
        </span>
      </button>
    ))}
  </div>
  {frameworkOptions.length > 0 && (
    <div class="chart-framework">
      <p class="framework-legend">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="3.2" fill="currentColor"></circle>
          <circle
            cx="8"
            cy="8"
            r="6.2"
            fill="none"
            stroke="var(--accent)"
            stroke-width="1.6"></circle>
        </svg>
        A ring marks an attack that used an offensive AI framework. Dot color
        still shows the AI role.
      </p>
      <label>
        Framework
        <select
          class="filter-select"
          data-framework-filter
          aria-label="Filter dots by offensive framework"
        >
          <option value="">Any framework</option>
          {frameworkOptions.map((framework) => (
            <option value={framework.id}>Used {framework.name}</option>
          ))}
        </select>
      </label>
    </div>
  )}
  <div class="chart-bottom">
    <span class="chart-inspector" data-chart-inspector></span>
    <span class="chart-bottom-links">
      {!large && (
        <a
          class="pew-egg"
          href={href("pewpew/")}
          title="Prefer lasers to nuance? (Or type “pew” anywhere.)"
        >
          pew pew
        </a>
      )}
      <a href={href("timeline/")}>Explore timeline</a>
    </span>
  </div>
  <span class="sr-only" data-chart-status aria-live="polite"></span>
</div>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-dot-chart]")
    .forEach((chart) => {
      const entries = Array.from(
        chart.querySelectorAll<SVGAElement>(".chart-entry"),
      );
      const legend = Array.from(
        chart.querySelectorAll<HTMLButtonElement>("[data-highlight]"),
      );
      const inspector = chart.querySelector<HTMLElement>(
        "[data-chart-inspector]",
      )!;
      let activeRole = "";
      let activeFramework = "";
      let stackIDs: Set<string> | null = null;
      const frameworkSelect = chart.querySelector<HTMLSelectElement>(
        "[data-framework-filter]",
      );
      const chartSource =
        chart.querySelector("svg title")?.id || "dot-chart";
      const inStack = (entry: SVGAElement) =>
        !stackIDs || stackIDs.has(entry.dataset.attackId!);
      const entryFrameworks = (entry: SVGAElement) => {
        try {
          return JSON.parse(entry.dataset.frameworks || "[]") as string[];
        } catch {
          return [];
        }
      };
      const matches = (entry: SVGAElement, role = activeRole) =>
        inStack(entry) &&
        (!role || entry.dataset.role === role) &&
        (!activeFramework || entryFrameworks(entry).includes(activeFramework));
      const period = chart.querySelector<HTMLElement>(".chart-period")!;
      const originalPeriod = period.textContent;
      const defaultMessage = () => {
        const shown = entries.filter((entry) => matches(entry)).length;
        const frameworkNote = activeFramework
          ? ` using ${frameworkSelect?.selectedOptions[0]?.textContent || activeFramework}`
          : "";
        if (stackIDs)
          return `${shown} highlighted${activeRole ? " in this role" : ""}${frameworkNote} · ${stackIDs.size} of ${entries.length} reports match your selections. Check their conditions below.`;
        if (activeRole || activeFramework)
          return `${shown} entries highlighted${frameworkNote}. Select a dot to explore.`;
        return "";
      };
      function highlight(role: string) {
        activeRole = role;
        entries.forEach(
          (entry) => (entry.dataset.muted = String(!matches(entry, role))),
        );
        legend.forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.highlight === role),
          );
          button.querySelector(".legend-count")!.textContent = String(
            entries.filter((entry) =>
              matches(
                entry,
                button.dataset.highlight ? button.dataset.highlight : "",
              ),
            ).length,
          );
        });
        period.textContent = stackIDs
          ? `${stackIDs.size} OF ${entries.length} MATCHED · ${originalPeriod?.split("·").at(-1)?.trim()}`
          : originalPeriod;
        chart
          .querySelectorAll<SVGTextElement>("[data-chart-year-count]")
          .forEach((label) => {
            const yearCount = entries.filter(
              (entry) =>
                entry.dataset.year === label.dataset.chartYearCount &&
                matches(entry, role),
            ).length;
            // Unfiltered labels zero-pad on purpose (05, 12). A filtered year
            // can be empty; padStart would print that as 00, so show 0.
            label.textContent =
              yearCount === 0 ? "0" : String(yearCount).padStart(2, "0");
          });
        inspector.textContent = defaultMessage();
        chart.querySelector("[data-chart-status]")!.textContent =
          defaultMessage();
      }
      const applyFramework = (id: string) => {
        activeFramework = id;
        if (frameworkSelect && frameworkSelect.value !== id)
          frameworkSelect.value = id;
        highlight(activeRole);
      };
      frameworkSelect?.addEventListener("change", () => {
        applyFramework(frameworkSelect.value);
        document.dispatchEvent(
          new CustomEvent("openattacks:framework", {
            detail: { id: frameworkSelect.value, source: chartSource },
          }),
        );
      });
      document.addEventListener("openattacks:framework", ((
        event: CustomEvent<{ id: string; source?: string }>,
      ) => {
        if (event.detail.source === chartSource) return;
        applyFramework(event.detail.id || "");
      }) as EventListener);
      const applyStack = (detail: { active: boolean; ids: string[] }) => {
        stackIDs = detail.active ? new Set(detail.ids) : null;
        highlight(activeRole);
      };
      document.addEventListener("stack:change", ((
        event: CustomEvent<{ active: boolean; ids: string[] }>,
      ) => applyStack(event.detail)) as EventListener);
      const stack = document.querySelector<HTMLElement>(
        "[data-stack-explorer]",
      );
      if (stack?.dataset.matchedIds)
        applyStack({
          active: stack.dataset.stackActive === "true",
          ids: JSON.parse(stack.dataset.matchedIds),
        });
      legend.forEach((button) =>
        button.addEventListener("click", () =>
          highlight(
            button.dataset.highlight === activeRole
              ? ""
              : button.dataset.highlight!,
          ),
        ),
      );
      entries.forEach((entry) => {
        const show = () => {
          inspector.textContent = `${entry.dataset.date} · ${entry.dataset.name}`;
        };
        entry.addEventListener("mouseenter", show);
        entry.addEventListener("focus", show);
        entry.addEventListener("mouseleave", () => {
          inspector.textContent = defaultMessage();
        });
        entry.addEventListener("blur", () => {
          inspector.textContent = defaultMessage();
        });
      });
      const toggle = chart.querySelector<HTMLButtonElement>(
        ".chart-motion-toggle",
      )!;
      const preference = matchMedia("(prefers-reduced-motion: reduce)");
      function setPaused(paused: boolean) {
        chart.dataset.paused = String(paused);
        toggle.setAttribute("aria-pressed", String(paused));
        toggle.setAttribute(
          "aria-label",
          `${paused ? "Play" : "Pause"} timeline animation`,
        );
        toggle.querySelector("span")!.textContent = paused ? "Play" : "Pause";
      }
      setPaused(preference.matches);
      preference.addEventListener("change", (event) =>
        setPaused(event.matches),
      );
      toggle.addEventListener("click", () =>
        setPaused(chart.dataset.paused !== "true"),
      );
    });
</script>
