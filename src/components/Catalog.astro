---
import {
  roles,
  href,
  formatDate,
  type Attack,
  dateKey,
  platforms,
  sectors as sectorOptions,
  platformGroups,
  sectorGroups,
} from "../lib/catalog";
import Icon from "./Icon.astro";
import RoleBadge from "./RoleBadge.astro";
import ViewTabs from "./ViewTabs.astro";
const { attacks, home = false } = Astro.props as {
  attacks: Attack[];
  home?: boolean;
};
const years = [
  ...new Set(attacks.map((attack) => attack.date_reported.slice(0, 4))),
]
  .sort()
  .reverse();
const options = (
  field: "regions" | "ai_tooling_and_models" | "related_magicsword_projects",
) =>
  [...new Set(attacks.flatMap((attack) => attack[field]))].sort((a, b) =>
    a.localeCompare(b),
  );
const sectors = [
  ...new Set(attacks.map((attack) => attack.victims_and_sectors)),
].sort();
const toolLabel = (tool: string) =>
  tool
    .replace(/ \(.*$/, "")
    .replace(/ CLI.*$/, "")
    .replace(/ via .*$/, "")
    .replace("Fake ", "");
---

<section id="catalog" class="catalog-section" data-catalog data-home={home}>
  <div class="catalog-heading">
    <div>
      <h2>
        {home ? "Explore the catalog" : "Attack catalog"}{" "}
        <span>{attacks.length}</span>
      </h2>
      <p>Real-world attacks. Primary sources. Actionable prevention.</p>
    </div>
    <details class="export-menu">
      <summary class="button">
        <Icon name="download" size={14} />
        Export data
        <Icon name="down" size={12} />
      </summary>
      <div class="export-options">
        <a href={href("api/attacks.json")} download="ai-attacks.json">
          Download JSON <Icon name="arrow" size={12} />
        </a>
        <a href={href("api/attacks.csv")} download="ai-attacks.csv">
          Download CSV <Icon name="arrow" size={12} />
        </a>
      </div>
    </details>
  </div>
  <ViewTabs />
  <div class="filters">
    <label class="search-box">
      <span class="sr-only">Search attacks</span>
      <Icon name="search" size={16} />
      <input
        type="search"
        name="q"
        id="attack-search"
        placeholder="Search attacks, tools, researchers…"
        autocomplete="off"
      />
      <span class="search-shortcut">/</span>
    </label>
    <select class="filter-select" name="role" aria-label="Filter by AI role">
      <option value="">All AI roles</option>
      {Object.entries(roles).map(([key, role]) => (
        <option value={key}>{role.label}</option>
      ))}
    </select>
    <select class="filter-select" name="year" aria-label="Filter by year">
      <option value="">All years</option>
      {years.map((year) => (
        <option value={year}>{year}</option>
      ))}
    </select>
    <select class="filter-select" name="region" aria-label="Filter by region">
      <option value="">All regions</option>
      {options("regions").map((region) => (
        <option value={region}>{region}</option>
      ))}
    </select>
    <button
      class="button more-filters"
      aria-expanded="false"
      aria-controls="advanced-filters"
    >
      <Icon name="filter" size={14} />
      More filters
    </button>
  </div>
  <div class="advanced-filters" id="advanced-filters" hidden>
    <label>
      AI model or tool
      <select name="tool" class="filter-select">
        <option value="">All models & tools</option>
        <optgroup label="Common platforms">
          {platforms
            .filter((platform) =>
              attacks.some((attack) =>
                platformGroups(attack).includes(platform.id),
              ),
            )
            .map((platform) => (
              <option value={`platform:${platform.id}`}>
                {platform.label}
              </option>
            ))}
        </optgroup>
        <optgroup label="As reported in source">
          {options("ai_tooling_and_models").map((tool) => (
            <option value={tool}>{tool}</option>
          ))}
        </optgroup>
      </select>
    </label>
    <label>
      Victim / sector
      <select name="sector" class="filter-select">
        <option value="">All victims & sectors</option>
        <optgroup label="Groups from reported descriptions">
          {sectorOptions
            .filter((sector) =>
              attacks.some((attack) =>
                sectorGroups(attack).includes(sector.id),
              ),
            )
            .map((sector) => (
              <option value={`category:${sector.id}`}>{sector.label}</option>
            ))}
        </optgroup>
        <optgroup label="As reported in source">
          {sectors.map((sector) => (
            <option value={sector}>
              {sector.length > 85 ? `${sector.slice(0, 85)}…` : sector}
            </option>
          ))}
        </optgroup>
      </select>
    </label>
    <label>
      Related project
      <select name="project" class="filter-select">
        <option value="">All MagicSword projects</option>
        {options("related_magicsword_projects").map((project) => (
          <option value={project}>{project}</option>
        ))}
      </select>
    </label>
    <label>
      Confidence
      <select
        name="confidence"
        class="filter-select"
        aria-label="Filter by confidence"
      >
        <option value="">All confidence levels</option>
        <option value="high">High</option>
        <option value="medium">Medium</option>
        <option value="low">Low</option>
        <option value="unassessed">Not assessed</option>
      </select>
    </label>
    <label>
      Evidence type
      <select name="evidence" class="filter-select">
        <option value="">All entries</option>
        <option value="observed">Reported attacks</option>
        <option value="research">Research / borderline</option>
      </select>
    </label>
  </div>
  <div class="results-meta">
    <span data-results-count aria-live="polite">
      Showing {Math.min(10, attacks.length)} of {attacks.length} entries
    </span>
    <button class="reset-filters" hidden>
      Clear filters <Icon name="close" size={11} />
    </button>
  </div>
  <div class="table-wrap">
    <table class="catalog-table">
      <caption class="sr-only">Documented AI-enabled attacks</caption>
      <thead>
        <tr>
          <th scope="col">ATTACK / CAMPAIGN</th>
          <th scope="col">AI ROLE</th>
          <th scope="col" aria-sort="descending">
            <button
              class="sort-button"
              aria-label="Sort by reported date, oldest first"
            >
              REPORTED <span data-sort-arrow>↓</span>
            </button>
          </th>
          <th scope="col" class="tool-column">
            AI TOOLING
          </th>
          <th scope="col" class="confidence-column">
            CONFIDENCE
          </th>
        </tr>
      </thead>
      <tbody>
        {attacks.map((attack, i) => (
          <tr
            data-attack-row
            data-id={attack.id}
            data-date={dateKey(attack.date_reported)}
            data-role={attack.ai_role}
            data-year={attack.date_reported.slice(0, 4)}
            data-regions={JSON.stringify(attack.regions)}
            data-tools={JSON.stringify(attack.ai_tooling_and_models)}
            data-platforms={JSON.stringify(platformGroups(attack))}
            data-sector={attack.victims_and_sectors}
            data-sector-groups={JSON.stringify(sectorGroups(attack))}
            data-projects={JSON.stringify(attack.related_magicsword_projects)}
            data-confidence={attack.confidence || "unassessed"}
            data-evidence={attack.borderline ? "research" : "observed"}
            data-search={[
              attack.name,
              attack.id,
              attack.technique_summary,
              attack.researcher,
              attack.org,
              attack.attribution_or_cluster,
              ...attack.ai_tooling_and_models,
              ...attack.other_tooling,
              attack.victims_and_sectors,
              ...attack.regions,
              ...(attack.tags || []),
            ]
              .join(" ")
              .toLowerCase()}
            hidden={i >= 10}
          >
            <td>
              <a class="incident-link" href={href(`attacks/${attack.id}/`)}>
                {attack.name}
              </a>
              <p class="incident-summary">{attack.technique_summary}</p>
              <div class="incident-org">
                {attack.org}
                {attack.borderline && (
                  <span class="research-marker">RESEARCH / BORDERLINE</span>
                )}
              </div>
            </td>
            <td>
              <RoleBadge role={attack.ai_role} short />
            </td>
            <td>
              <time class="table-date" datetime={attack.date_reported}>
                {formatDate(attack.date_reported)}
              </time>
            </td>
            <td class="tool-column">
              {attack.ai_tooling_and_models[0] ? (
                <span
                  class="tool-chip"
                  title={attack.ai_tooling_and_models.join(" · ")}
                >
                  {toolLabel(attack.ai_tooling_and_models[0])}
                </span>
              ) : (
                <span class="muted">Unknown</span>
              )}
            </td>
            <td class="confidence-column">
              <span
                class={`confidence confidence-${attack.confidence || "unassessed"}`}
              >
                {attack.confidence
                  ? attack.confidence.charAt(0).toUpperCase() +
                    attack.confidence.slice(1)
                  : "Not assessed"}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="empty-state" hidden>
    <Icon name="search" size={26} />
    <h3>No matching attacks</h3>
    <p>Try another search or clear your filters to see all entries.</p>
    <button class="button" data-empty-reset>
      Clear all filters
    </button>
  </div>
  <div class="pagination">
    <span data-page-status>Showing 1–10 of {attacks.length} entries</span>
    {home ? (
      <a class="text-link" href={href("catalog/")}>
        View all {attacks.length} attacks <Icon name="right" size={14} />
      </a>
    ) : (
      <nav class="pagination-actions" aria-label="Catalog pagination">
        <button
          class="page-button"
          data-prev
          aria-label="Previous page"
          disabled
        >
          ←
        </button>
        <span class="page-number-buttons"></span>
        <button class="page-button" data-next aria-label="Next page">
          →
        </button>
      </nav>
    )}
  </div>
  <p class="catalog-note">
    <Icon name="shield" size={12} />
    Every entry links to its sources. Research demonstrations and uncertain
    cases are marked. Confidence refers to AI’s role in the attack.
  </p>
  <noscript>
    <p class="catalog-note">
      Enable JavaScript to search, filter and paginate. All 68 entries remain
      available in the <a href={href("api/attacks.json")}>JSON export</a> and{" "}
      <a href={href("timeline/")}>timeline</a>.
    </p>
  </noscript>
</section>
<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .page-number-buttons {
    display: flex;
    gap: 3px;
  }
</style>
<script src="../lib/catalog-client.ts"></script>
