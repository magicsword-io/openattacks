---
import {
  roles,
  href,
  formatDate,
  type Attack,
  dateKey,
  platforms,
  sectors as sectorOptions,
  platformGroups,
  sectorGroups,
} from "../lib/catalog";
import { present, environments, evidenceTypes } from "../lib/presentation";
import Icon from "./Icon.astro";
import ViewTabs from "./ViewTabs.astro";
const { attacks } = Astro.props as { attacks: Attack[] };
const years = [...new Set(attacks.map((a) => a.date_reported.slice(0, 4)))]
  .sort()
  .reverse();
const regions = [...new Set(attacks.flatMap((a) => a.regions))].sort();
const populatedEnvironments = new Set(
  attacks.flatMap((a) => present(a).environments),
);
const populatedEvidence = new Set(attacks.map((a) => present(a).evidence));
const hasConfidence = attacks.some((a) => a.confidence);
const monthLabel = (month: string) =>
  new Intl.DateTimeFormat("en", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${month}-01T00:00:00Z`));
const firstPageCounts = new Map<string, number>();
attacks.slice(0, 10).forEach((attack) => {
  const month = attack.date_reported.slice(0, 7);
  firstPageCounts.set(month, (firstPageCounts.get(month) || 0) + 1);
});
---

<section
  id="catalog"
  class="catalog-section catalog-focused catalog-ledger"
  data-catalog
>
  <div class="catalog-controls">
    <div class="filters">
      <label class="search-box">
        <span class="sr-only">Search attacks</span>
        <Icon name="search" size={16} />
        <input
          type="search"
          name="q"
          id="attack-search"
          placeholder="Search attacks, tools, techniques…"
          autocomplete="off"
        />
        <span class="search-shortcut">/</span>
      </label>
      <select
        class="filter-select"
        name="environment"
        aria-label="Filter by environment"
      >
        <option value="">Any environment</option>
        {Object.entries(environments)
          .filter(([id]) => populatedEnvironments.has(id))
          .map(([id, label]) => (
            <option value={id}>{label}</option>
          ))}
      </select>
      <select
        class="filter-select"
        name="role"
        aria-label="Filter by attack pattern"
      >
        <option value="">Any pattern</option>
        {Object.entries(roles).map(([id, role]) => (
          <option value={id}>{role.short}</option>
        ))}
      </select>
      <select
        class="filter-select"
        name="evidence"
        aria-label="Filter by evidence type"
      >
        <option value="">Any evidence</option>
        {Object.entries(evidenceTypes)
          .filter(([id]) => populatedEvidence.has(id))
          .map(([id, label]) => (
            <option value={id}>{label}</option>
          ))}
      </select>
      <button
        class="button more-filters"
        aria-expanded="false"
        aria-controls="advanced-filters"
      >
        <Icon name="filter" size={14} /> More filters
      </button>
      <details class="export-menu">
        <summary class="button">
          <Icon name="download" size={14} /> Export{" "}
          <Icon name="down" size={12} />
        </summary>
        <div class="export-options">
          <a href={href("api/attacks.json")} download="openattacks.json">
            Complete JSON
          </a>
          <a href={href("api/attacks.csv")} download="openattacks.csv">
            CSV
          </a>
          <a href={href("api/catalog.json")}>Browse index</a>
        </div>
      </details>
    </div>
    <div class="catalog-list-toolbar">
      <ViewTabs compact />
      <div class="catalog-list-status">
        <span data-results-count aria-live="polite">
          Showing {attacks.length} entries
        </span>
        <button
          class="sort-button"
          aria-label="Sort by reported date, oldest first"
          aria-pressed="false"
        >
          <span data-sort-label>Newest first</span>{" "}
          <span data-sort-arrow aria-hidden="true">
            ↓
          </span>
        </button>
      </div>
    </div>
  </div>
  <div class="advanced-filters" id="advanced-filters" hidden>
    <label>
      Model / platform
      <select name="tool" class="filter-select">
        <option value="">Any model / platform</option>
        {platforms
          .filter((p) => attacks.some((a) => platformGroups(a).includes(p.id)))
          .map((p) => (
            <option value={`platform:${p.id}`}>{p.label}</option>
          ))}
      </select>
    </label>
    <label>
      Sector
      <select name="sector" class="filter-select">
        <option value="">Any sector</option>
        {sectorOptions
          .filter(
            (s) =>
              s.id !== "unknown" &&
              attacks.some((a) => sectorGroups(a).includes(s.id)),
          )
          .map((s) => (
            <option value={`category:${s.id}`}>{s.label}</option>
          ))}
      </select>
    </label>
    <label>
      Reported year
      <select class="filter-select" name="year" aria-label="Filter by year">
        <option value="">Any year</option>
        {years.map((year) => (
          <option value={year}>{year}</option>
        ))}
      </select>
    </label>
    <label>
      Geography
      <select class="filter-select" name="region" aria-label="Filter by region">
        <option value="">Any geography</option>
        {regions.map((r) => (
          <option value={r}>{r === "unknown" ? "Not reported" : r}</option>
        ))}
      </select>
    </label>
    {hasConfidence && (
      <label>
        AI-role confidence
        <select
          name="confidence"
          class="filter-select"
          aria-label="Filter by confidence"
        >
          <option value="">Any assessment</option>
          {["high", "medium", "low"]
            .filter((v) => attacks.some((a) => a.confidence === v))
            .map((v) => (
              <option value={v}>{v}</option>
            ))}
          <option value="unassessed">Not assessed</option>
        </select>
      </label>
    )}
    <p class="advanced-filter-note">
      Products and sectors use normalized groups. Original names, commands and
      artifacts remain searchable and available in the source record.
    </p>
  </div>
  <div class="results-meta" hidden>
    <div
      class="active-filter-chips"
      role="group"
      aria-label="Active filters"
    ></div>
    <button class="reset-filters" hidden>
      Clear filters <Icon name="close" size={11} />
    </button>
  </div>
  <ol class="catalog-entry-list" aria-label="AI attack catalog" data-entry-list>
    {attacks.map((attack, i) => {
      const display = present(attack);
      const month = attack.date_reported.slice(0, 7);
      const count = firstPageCounts.get(month) || 0;
      return (
        <>
          {i < 10 &&
            (i === 0 || attacks[i - 1].date_reported.slice(0, 7) !== month) && (
              <li class="catalog-month" data-month-heading>
                <h2>
                  Reported in {monthLabel(month)}{" "}
                  <span>
                    {count} {count === 1 ? "entry" : "entries"} on this page
                  </span>
                </h2>
              </li>
            )}
          <li
            data-attack-row
            data-id={attack.id}
            data-month={attack.date_reported.slice(0, 7)}
            data-date={dateKey(attack.date_reported)}
            data-role={attack.ai_role}
            data-year={attack.date_reported.slice(0, 4)}
            data-environments={JSON.stringify(display.environments)}
            data-regions={JSON.stringify(attack.regions)}
            data-tools={JSON.stringify(attack.ai_tooling_and_models)}
            data-platforms={JSON.stringify(platformGroups(attack))}
            data-sector={attack.victims_and_sectors}
            data-sector-groups={JSON.stringify(sectorGroups(attack))}
            data-confidence={
              hasConfidence ? attack.confidence || "unassessed" : undefined
            }
            data-evidence={display.evidence}
            data-search={[
              display.title,
              display.summary,
              attack.name,
              attack.id,
              attack.technique_summary,
              attack.researcher,
              attack.org,
              attack.attribution_or_cluster,
              ...attack.ai_tooling_and_models,
              ...attack.other_tooling,
              attack.victims_and_sectors,
              ...attack.regions,
              ...(attack.tags || []),
            ]
              .join(" ")
              .toLowerCase()}
            hidden={i >= 10}
          >
            <article class="catalog-entry">
              <time datetime={attack.date_reported}>
                {formatDate(attack.date_reported)} · Reported
              </time>
              <h3>
                <a class="incident-link" href={href(`attacks/${attack.id}/`)}>
                  {display.title}
                </a>
              </h3>
              <p class="incident-summary">{display.summary}</p>
              <div class="catalog-entry-meta">
                <span class={`evidence-badge evidence-${display.evidence}`}>
                  {evidenceTypes[display.evidence]}
                </span>
                {display.environments.filter((id) => id !== "unspecified")
                  .length > 0 && (
                  <span>
                    {display.environments
                      .filter((id) => id !== "unspecified")
                      .map((id) => environments[id])
                      .join(" · ")}
                  </span>
                )}
                <span>{roles[attack.ai_role].short}</span>
              </div>
            </article>
          </li>
        </>
      );
    })}
  </ol>
  <div class="empty-state" hidden>
    <Icon name="search" size={26} />
    <h3>No matching attacks</h3>
    <p>Try another search or clear your filters.</p>
    <button class="button" data-empty-reset>
      Clear all filters
    </button>
  </div>
  <div class="pagination">
    <span data-page-status>
      Showing 1–{Math.min(10, attacks.length)} of {attacks.length} entries
    </span>
    <nav class="pagination-actions" aria-label="Catalog pagination">
      <button class="page-button" data-prev aria-label="Previous page" disabled>
        ←
      </button>
      <span class="page-number-buttons"></span>
      <button class="page-button" data-next aria-label="Next page">
        →
      </button>
    </nav>
  </div>
  <p class="catalog-note">
    Evidence labels describe the source account. Research, advertised claims and
    reported campaigns carry different qualifications.
  </p>
  <noscript>
    <p class="catalog-note">
      Search and pagination require JavaScript. All {attacks.length} entries are
      available in the <a href={href("api/attacks.json")}>JSON export</a> and{" "}
      <a href={href("timeline/")}>timeline</a>.
    </p>
  </noscript>
</section>
<script src="../lib/catalog-client.ts"></script>
