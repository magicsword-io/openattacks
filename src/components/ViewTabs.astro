---
import { href, formatDate } from "../lib/catalog";
import { siteUpdated } from "../lib/site-updated";
import Icon from "./Icon.astro";
const { active = "catalog", compact = false } = Astro.props;
---

<div class:list={["catalog-toolbar", { "catalog-toolbar-compact": compact }]}>
  <nav class="view-tabs" aria-label="Catalog views">
    <a
      class:list={{ active: active === "catalog" }}
      aria-current={active === "catalog" ? "page" : undefined}
      href={href()}
    >
      <Icon name="list" size={14} />
      List
    </a>
    <a
      class:list={{ active: active === "timeline" }}
      aria-current={active === "timeline" ? "page" : undefined}
      href={href("timeline/")}
    >
      <Icon name="chart" size={14} />
      Timeline
    </a>
    <a
      class:list={{ active: active === "regions" }}
      aria-current={active === "regions" ? "page" : undefined}
      href={href("regions/")}
    >
      <Icon name="globe" size={14} />
      Regions
    </a>
  </nav>
  {!compact && (
    <span class="update-label mono">
      LAST UPDATED {formatDate(siteUpdated).toUpperCase()}
    </span>
  )}
</div>
