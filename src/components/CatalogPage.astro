---
import Layout from "../layouts/Layout.astro";
import Catalog from "./Catalog.astro";
import TimelineChart from "./TimelineChart.astro";
import { getAttacks, href, formatDate } from "../lib/catalog";
import { siteUpdated } from "../lib/site-updated";
const { showTimeline = false } = Astro.props;
const attacks = await getAttacks();
---

<Layout
  title="OpenAttacks — The open catalog of AI attacks"
  description="Explore AI attacks observed in the wild or documented in public reporting. Sourced cases and demonstrated vulnerabilities; no conceptual or hypothetical entries."
  canonicalPath={href()}
  bodyClass={showTimeline ? "catalog-landing" : undefined}
>
  <div class="container catalog-home">
    <header class="catalog-intro">
      <h1>The open catalog of AI attacks.</h1>
      <p>
        Explore AI attacks observed in the wild or documented in public reporting.
        Understand how attacks work and what to review.
      </p>
      <div class="catalog-intro-meta">
        <span>
          <strong>{attacks.length}</strong> sourced entries
          <span class="meta-separator" aria-hidden="true">
            ·
          </span>
          Updated <time datetime={siteUpdated}>{formatDate(siteUpdated)}</time>
        </span>
        <div class="catalog-intro-links">
          {showTimeline && (
            <a class="text-link" href="#catalog">
              Browse the catalog
            </a>
          )}
          <a class="text-link" href={href("stack/")}>
            Find attacks relevant to my stack
          </a>
        </div>
      </div>
    </header>
    {showTimeline && (
      <section class="home-timeline" aria-label="AI attacks over time">
        <TimelineChart attacks={attacks} />
      </section>
    )}
    <Catalog attacks={attacks} />
  </div>

  <script is:inline define:vars={{ stackURL: href("stack/") }}>
    // Preserve shared stack selections from before personalization moved off home.
    const legacyStackURL = new URL(location.href);
    if (
      ["tools", "os", "mcp"].some((key) =>
        legacyStackURL.searchParams.has(key),
      ) ||
      legacyStackURL.hash === "#your-stack"
    ) {
      legacyStackURL.pathname = stackURL;
      location.replace(legacyStackURL.href);
    }
  </script>
</Layout>
