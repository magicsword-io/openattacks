---
import "@fontsource-variable/inter-tight";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import HeaderActionDialog from "../components/HeaderActionDialog.astro";
import "../styles/catalog.css";
import Icon from "../components/Icon.astro";
import MagicSwordLogo from "../components/MagicSwordLogo.astro";
import IncidentReportForm from "../components/IncidentReportForm.astro";
import { href, repo, formatDate } from "../lib/catalog";
import { siteUpdated } from "../lib/site-updated";
import { preventionURL } from "../lib/site-links";
import { magicswordURL } from "../lib/magicsword-links.mjs";
interface Props {
  title?: string;
  description?: string;
  active?: string;
  // A string shows that review date; null marks an entry nobody has reviewed yet.
  // Omit it to show when the site was last updated.
  lastReviewed?: string | null;
  canonicalPath?: string;
}
const {
  title = "OpenAttacks — The open catalog of AI attacks",
  description = "How attackers actually use AI, sourced and mapped to prevention. Explore a community-maintained catalog of AI-enabled attacks from MagicSword.",
  active = "catalog",
  lastReviewed,
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site || Astro.url.origin);
const imageURL = new URL(
  href("openattacks-share-v2.png"),
  Astro.site || Astro.url.origin,
);
const imageAlt =
  "OpenAttacks by MagicSword. The open catalog of AI attacks, shown with a mapped attack flow on a dark grid.";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Tag Manager -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtm.js?id=GTM-NLNMJG32"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
    </script>
    <!-- End Google Tag Manager -->
    <meta name="theme-color" content="#08080a" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />
    <link rel="describedby" href={href("llms.txt")} />
    <link
      rel="alternate"
      type="text/plain"
      title="LLM discovery guide"
      href={href("llms.txt")}
    />
    <link
      rel="alternate"
      type="text/markdown"
      title="OpenAttacks agent skill"
      href={href("skills/openattacks/SKILL.md")}
    />
    <link
      rel="alternate"
      type="application/json"
      title="Complete attack catalog"
      href={href("api/attacks.json")}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="OpenAttacks RSS feed"
      href={href("rss.xml")}
    />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("openattacks-theme") ||
          localStorage.getItem("ai-attacks-theme") ||
          "dark";
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a
          class="wordmark header-wordmark"
          href={href()}
          aria-label="OpenAttacks home"
        >
          <span class="catalog-wordmark">
            <span>Open</span>Attacks
          </span>
        </a>
        <a
          class="header-credit"
          href={magicswordURL("https://magicsword.io/", "header-credit")}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>by</span>
          <MagicSwordLogo />
        </a>
        <nav aria-label="Main navigation">
          <a
            class:list={{ active: active === "patterns" }}
            href={href("patterns/")}
          >
            Patterns
          </a>
          <a
            class="nav-about"
            class:list={{ active: active === "about" }}
            href={href("about/")}
          >
            About
          </a>
          <a class:list={{ active: active === "use" }} href={href("use/")}>
            Use with an LLM
          </a>
          <a href={href("api/attacks.json")}>JSON API</a>
          <a
            class="nav-prevent"
            href={preventionURL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Prevent
          </a>
        </nav>
        <div class="header-actions">
          <a
            class="github-link"
            aria-label="View on GitHub"
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" size={18} />
            <span>View on GitHub</span>
          </a>
          <span class="header-divider"></span>
          <a class="button" href={href("rss.xml")} type="application/rss+xml">
            Follow via RSS
          </a>
          <HeaderActionDialog
            id="incident-report-dialog"
            label="Report an incident"
            title="Report or suggest an update"
            href={href("suggest/")}
            primary
          >
            <IncidentReportForm />
          </HeaderActionDialog>
          <button
            class="icon-button theme-toggle"
            aria-label="Switch to light mode"
            title="Toggle color theme"
          >
            <Icon name="sun" size={19} />
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <div class="footer-top">
        <a
          class="wordmark"
          href={magicswordURL("https://magicsword.io/", "footer-logo")}
          target="_blank"
          rel="noopener noreferrer"
        >
          <MagicSwordLogo />
        </a>
        <p>
          A community resource for the people defending against AI-enabled
          attacks.
        </p>
        <div class="footer-links">
          <a href={href("stack/")}>Find my stack</a>
          <a href={href("about/")}>About the project</a>
          <a href={href("suggest/")}>Suggest an update</a>
          <a
            href={`${repo}/blob/main/CONTRIBUTING.md`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Contribute
          </a>
          <a href={href("llms.txt")}>llms.txt</a>
          <a href={href("use/")}>Use with an LLM</a>
          <a href={href("api/attacks.json")}>JSON API</a>
          <a href={href("rss.xml")}>RSS</a>
          <a href={href("pewpew/")}>Pew Pew Map</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>
          Built in the open. Maintained by MagicSword & the community.
        </span>
        <span>
          {lastReviewed === null ? (
            "Not yet reviewed"
          ) : lastReviewed ? (
            <>
              Last reviewed{" "}
              <time datetime={lastReviewed}>{formatDate(lastReviewed)}</time>
            </>
          ) : (
            <>
              Last updated{" "}
              <time datetime={siteUpdated}>{formatDate(siteUpdated)}</time>
            </>
          )}
        </span>
      </div>
    </footer>
    <script>
      const themeButton =
        document.querySelector<HTMLButtonElement>(".theme-toggle");
      const syncTheme = () => {
        themeButton?.setAttribute(
          "aria-label",
          `Switch to ${document.documentElement.dataset.theme === "dark" ? "light" : "dark"} mode`,
        );
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute(
            "content",
            getComputedStyle(document.documentElement)
              .getPropertyValue("--bg")
              .trim(),
          );
      };
      syncTheme();
      themeButton?.addEventListener("click", () => {
        const theme =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem("openattacks-theme", theme);
        } catch {}
        syncTheme();
      });
    </script>
    <script src="../lib/outbound-links.ts"></script>
  </body>
</html>
