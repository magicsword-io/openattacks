---
import "@fontsource-variable/manrope";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import MagicSwordLogo from "../components/MagicSwordLogo.astro";
import { href, repo, reviewed, formatDate } from "../lib/catalog";
interface Props {
  title?: string;
  description?: string;
  active?: string;
  lastReviewed?: string;
}
const {
  title = "AI Attacks — Real attacks. Clear patterns.",
  description = "How attackers actually use AI, sourced and mapped to prevention. Explore a community-maintained catalog of AI-enabled attacks from MagicSword.",
  active = "catalog",
  lastReviewed = reviewed,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const imageURL = new URL(href("og.png"), Astro.site || Astro.url.origin);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101214" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />
    <link
      rel="alternate"
      type="text/plain"
      title="LLM discovery guide"
      href={href("llms.txt")}
    />
    <link
      rel="alternate"
      type="application/json"
      title="Complete attack catalog"
      href={href("api/attacks.json")}
    />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("ai-attacks-theme") || "dark";
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a
          class="wordmark header-wordmark"
          href={href()}
          aria-label="MagicSword AI Attacks The open intelligence catalog home"
        >
          <MagicSwordLogo />
          <span class="brand-divider"></span>
          <span class="catalog-wordmark">
            AI ATTACKS<span class="byline">The open intelligence catalog</span>
          </span>
        </a>
        <nav aria-label="Main navigation">
          <a
            class:list={{ active: active === "catalog" }}
            href={href("catalog/")}
          >
            Catalog
          </a>
          <a
            class:list={{ active: active === "timeline" }}
            href={href("timeline/")}
          >
            Timeline
          </a>
          <a
            class:list={{ active: active === "patterns" }}
            href={href("patterns/")}
          >
            Patterns
          </a>
          <a class:list={{ active: active === "about" }} href={href("about/")}>
            About
          </a>
        </nav>
        <div class="header-actions">
          <a
            class="github-link"
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" size={18} />
            <span>View on GitHub</span>
            <Icon name="arrow" size={13} />
          </a>
          <span class="header-divider"></span>
          <button
            class="icon-button theme-toggle"
            aria-label="Switch to light mode"
            title="Toggle color theme"
          >
            <Icon name="sun" size={19} />
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <div class="footer-top">
        <a
          class="wordmark"
          href="https://magicsword.io"
          target="_blank"
          rel="noopener noreferrer"
        >
          <MagicSwordLogo />
        </a>
        <p>
          A community resource for the people defending against AI-enabled
          attacks.
        </p>
        <div class="footer-links">
          <a href={href("about/")}>About the project</a>
          <a
            href={`${repo}/blob/main/CONTRIBUTING.md`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Contribute <Icon name="arrow" size={12} />
          </a>
          <a href={href("llms.txt")}>llms.txt</a>
          <a href={href("api/attacks.json")}>
            JSON API <Icon name="arrow" size={12} />
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>
          Built in the open. Maintained by MagicSword & the community.
        </span>
        <span>
          Last reviewed{" "}
          <time datetime={lastReviewed}>{formatDate(lastReviewed)}</time>
        </span>
      </div>
    </footer>
    <script>
      const themeButton =
        document.querySelector<HTMLButtonElement>(".theme-toggle");
      const syncThemeLabel = () =>
        themeButton?.setAttribute(
          "aria-label",
          `Switch to ${document.documentElement.dataset.theme === "dark" ? "light" : "dark"} mode`,
        );
      syncThemeLabel();
      themeButton?.addEventListener("click", () => {
        const theme =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem("ai-attacks-theme", theme);
        } catch {}
        syncThemeLabel();
      });
    </script>
  </body>
</html>
