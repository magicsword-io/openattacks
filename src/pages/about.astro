---
import Layout from "../layouts/Layout.astro";
import AgentAccess from "../components/AgentAccess.astro";
import { getAttacks, href, repo } from "../lib/catalog";
import { magicswordURL } from "../lib/magicsword-links.mjs";

const attacks = await getAttacks();
const years = attacks.map((attack) => Number(attack.date_reported.slice(0, 4)));
const firstYear = Math.min(...years);
const lastYear = Math.max(...years);
---

<Layout
  title="About — OpenAttacks"
  description="Meet the OpenAttacks maintainers and learn how the community project turns documented AI attack research into practical resources for defenders."
  active="about"
>
  <div class="container">
    <article class="about-page">
      <header class="about-intro">
        <div>
          <span class="eyebrow">OPEN KNOWLEDGE. BETTER DEFENSE.</span>
          <h1>About OpenAttacks</h1>
          <p class="intro">
            OpenAttacks is a community-maintained catalog of reported attacks
            and security research where AI is part of the attack path. Every
            entry keeps the evidence, uncertainty, and original researchers in
            view.
          </p>
        </div>
        <div class="about-summary">
          <p>
            Built by defenders for defenders, the catalog turns public research
            into explorable attack flows, defensive context, draft hunts, and
            machine-readable data without replacing the original source.
          </p>
          <div class="about-actions">
            <a class="button button-primary" href={href()}>
              Browse the catalog
            </a>
            <a class="text-link" href="#people-title">
              Meet the maintainers
            </a>
          </div>
        </div>
      </header>

      <section
        class="about-section about-mission"
        aria-labelledby="mission-title"
      >
        <span class="eyebrow">A SHARED DEFENSIVE RESOURCE</span>
        <h2 id="mission-title">Evidence before assumptions.</h2>
        <p>
          OpenAttacks helps researchers, incident responders, detection
          engineers, and security teams understand how AI is appearing in real
          attack paths. The project welcomes sourced contributions and makes the
          resulting catalog available through the website, public APIs, Markdown
          bundles, and an agent skill.
        </p>
        <p>
          The catalog currently contains{" "}
          <strong>{attacks.length} entries</strong> spanning {firstYear}–
          {lastYear}. It records documented coverage, not global attack
          prevalence or a risk ranking.
        </p>
      </section>

      <section
        class="about-section people-section"
        aria-labelledby="people-title"
      >
        <div class="section-heading">
          <div>
            <span class="eyebrow">MAINTAINERS</span>
            <h2 id="people-title">The people behind the project</h2>
          </div>
        </div>

        <div class="people-grid">
          <article class="person-card">
            <img
              src={href("images/maintainers/kostas.jpg")}
              alt="Portrait of Kostas"
              width="400"
              height="400"
            />
            <div class="person-copy">
              <h3>
                <a
                  href="https://kostas.page/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Kostas
                </a>
              </h3>
              <p>
                Kostas builds tools and research for threat hunting, threat
                intelligence, and detection engineering. His work includes
                Threat Hunting Labs, EDR Telemetry, and DetectionStream.
              </p>
            </div>
            <div class="person-links">
              <a href="https://github.com/tsale">GitHub</a>
              <a href="https://threathuntinglabs.com/">Threat Hunting Labs</a>
            </div>
          </article>

          <article class="person-card">
            <img
              src={href("images/maintainers/michael-haag.png")}
              alt="Portrait of Michael Haag"
              width="200"
              height="200"
            />
            <div class="person-copy">
              <h3>
                <a
                  href="https://twitter.com/M_haggis"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Michael Haag
                </a>
              </h3>
              <p>
                Michael is MagicSword's CTO and co-founder. A former principal
                threat researcher at Splunk, he helped found Atomic Red Team,
                LOLDrivers, and LOLRMM.
              </p>
            </div>
            <div class="person-links">
              <a
                href={magicswordURL(
                  "https://www.magicsword.io/about",
                  "about-michael-haag",
                )}
              >
                MagicSword
              </a>
              <a href="https://www.youtube.com/@atomicsonafriday">
                Atomics on a Friday
              </a>
            </div>
          </article>

          <article class="person-card">
            <img
              src={href("images/maintainers/jose-hernandez.png")}
              alt="Portrait of Jose Hernandez"
              width="200"
              height="200"
            />
            <div class="person-copy">
              <h3>
                <a
                  href="https://twitter.com/_josehelps"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Jose Hernandez
                </a>
              </h3>
              <p>
                Jose is MagicSword's CEO and co-founder. He turns attacker
                techniques into practical defenses and contributes to projects
                including Atomic Red Team, LOLBAS, and Splunk Attack Range.
              </p>
            </div>
            <div class="person-links">
              <a href="https://github.com/josehelps">GitHub</a>
              <a
                href={magicswordURL(
                  "https://www.magicsword.io/about",
                  "about-jose-hernandez",
                )}
              >
                MagicSword
              </a>
            </div>
          </article>

          <article class="person-card">
            <img
              src={href("images/maintainers/nasreddine-bencherchali.png")}
              alt="Portrait of Nasreddine Bencherchali"
              width="200"
              height="200"
            />
            <div class="person-copy">
              <h3>
                <a
                  href="https://twitter.com/nas_bench"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Nasreddine Bencherchali
                </a>
              </h3>
              <p>
                Nasreddine focuses on detection engineering and threat hunting
                at Cisco/Splunk. He maintains Sigma and co-founded the
                EVTX-ETW-Resources project.
              </p>
            </div>
            <div class="person-links">
              <a href="https://github.com/nasbench">GitHub</a>
              <a href="https://nasbench.medium.com">Research</a>
            </div>
          </article>

          <article class="person-card">
            <img
              src={href("images/maintainers/scott-roberts.png")}
              alt="Portrait of Scott Roberts"
              width="512"
              height="512"
            />
            <div class="person-copy">
              <h3>
                <a
                  href="https://www.linkedin.com/in/scottroberts/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Scott Roberts
                </a>
              </h3>
              <p>
                Scott is a network defender, developer, educator, and author of
                O'Reilly's <em>Intelligence-Driven Incident Response</em>. He
                brings more than 15 years of experience in threat research,
                detection, and incident response.
              </p>
            </div>
            <div class="person-links">
              <a href="https://github.com/sroberts">GitHub</a>
              <a href="https://sroberts.io/">Website</a>
            </div>
          </article>
        </div>
      </section>

      <section class="about-section agent-section" id="for-agents">
        <span class="eyebrow">MACHINE READABLE</span>
        <h2>Read OpenAttacks with an AI assistant</h2>
        <p>
          The agent skill is the easiest entry point for Claude, Cursor, and
          other assistants. The same validated YAML also produces a concise
          index, per-attack Markdown, smaller category and month bundles, the
          full catalog, and structured JSON.
        </p>
        <div class="resource-links">
          <a href={href("use/")}>Install the agent skill</a>
          <a href={href("llms.txt")}>llms.txt</a>
          <a href={href("llms-full.txt")}>Full Markdown catalog</a>
          <a href={href("data/attacks.json")}>Structured JSON</a>
        </div>
      </section>

      <section
        class="about-section contribute-section"
        aria-labelledby="contribute-title"
      >
        <span class="eyebrow">COMMUNITY CONTRIBUTIONS</span>
        <h2 id="contribute-title">Contribute a documented attack</h2>
        <p>
          Attack records live in YAML in the public repository. Contributions
          can add sourced cases, correct metadata, improve defensive context, or
          link new research and detections. Uncertain details should say
          “unknown,” and submissions must not include live victim data or
          unredacted victim IP addresses.
        </p>
        <div class="resource-links">
          <a href={repo + "/blob/main/CONTRIBUTING.md"}>Contribution guide</a>
          <a href={repo + "/issues/new/choose"}>Submit a finding</a>
          <a href={repo}>GitHub repository</a>
        </div>
      </section>

      <AgentAccess />
    </article>
  </div>
</Layout>

<style>
  .about-page {
    padding: 48px 0 32px;
  }

  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    gap: 56px;
    align-items: end;
    padding-bottom: 42px;
    border-bottom: 1px solid var(--line);
  }

  .about-intro .eyebrow,
  .about-section > .eyebrow,
  .section-heading .eyebrow {
    color: var(--accent);
  }

  .about-intro h1 {
    margin: 14px 0;
    font-size: clamp(38px, 4vw, 52px);
    letter-spacing: -0.05em;
  }

  .intro {
    max-width: 700px;
    margin: 0;
    font-size: 16px;
    line-height: 1.8;
  }

  .about-summary {
    padding-left: 22px;
    border-left: 2px solid var(--accent);
  }

  .about-summary p,
  .about-section p {
    color: var(--muted);
    line-height: 1.75;
  }

  .about-summary p {
    margin: 0;
  }

  .about-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 20px;
    margin-top: 20px;
  }

  .about-actions .text-link {
    color: var(--accent);
    font-size: 12px;
  }

  .about-section {
    margin-top: 52px;
  }

  .about-section h2 {
    margin: 10px 0 16px;
    font-size: 28px;
    font-weight: 550;
  }

  .about-mission {
    max-width: 820px;
  }

  .about-mission p {
    font-size: 15px;
  }

  .about-mission strong {
    color: var(--text);
    font-weight: 600;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin-bottom: 0;
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }

  .person-card {
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex-direction: column;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
  }

  .person-card img {
    display: block;
    width: 104px;
    height: 104px;
    margin-bottom: 18px;
    border: 1px solid var(--line);
    border-radius: 50%;
    object-fit: cover;
  }

  .person-card h3 {
    margin: 0 0 4px;
    font-size: 20px;
    font-weight: 550;
    letter-spacing: -0.03em;
  }

  .person-card h3 a {
    color: var(--text);
  }

  .person-card h3 a:hover,
  .person-links a:hover {
    color: var(--accent);
  }

  .person-card .person-copy > p:last-child {
    margin-bottom: 20px;
    font-size: 13px;
  }

  .person-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
    font-size: 11px;
    color: var(--muted);
  }

  .agent-section,
  .contribute-section {
    max-width: 900px;
    padding: 28px 30px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
  }

  .agent-section p,
  .contribute-section p {
    max-width: 760px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .resource-links a {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 5px;
    color: var(--text);
    font-size: 11px;
  }

  .resource-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .about-page :global(.agent-access) {
    margin-top: 52px;
  }

  @media (max-width: 1100px) {
    .about-intro {
      gap: 36px;
    }

    .people-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 740px) {
    .about-page {
      padding-top: 30px;
    }

    .about-intro {
      grid-template-columns: 1fr;
      gap: 26px;
      padding-bottom: 32px;
    }

    .about-summary {
      padding-left: 16px;
    }

    .about-section {
      margin-top: 38px;
    }

    .section-heading {
      display: block;
    }

    .people-grid {
      grid-template-columns: 1fr;
    }

    .person-card {
      padding: 20px;
    }

    .person-card {
      display: grid;
      grid-template-columns: 84px minmax(0, 1fr);
      gap: 0 16px;
    }

    .person-card img {
      width: 84px;
      height: 84px;
      margin: 0;
    }

    .person-links {
      grid-column: 1 / -1;
      margin-top: 16px;
    }

    .agent-section,
    .contribute-section {
      padding: 22px 20px;
    }
  }

  @media (max-width: 480px) {
    .person-card {
      display: flex;
    }

    .person-card img {
      margin-bottom: 16px;
    }
  }
</style>
