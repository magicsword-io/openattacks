---
import Layout from "../../layouts/Layout.astro";
import SimulationPreview from "../../components/SimulationPreview.astro";
import DetectionSection from "../../components/DetectionSection.astro";
import { simulationsFor } from "../../lib/simulation-preview.mjs";
import Icon from "../../components/Icon.astro";
import AttackFlowSection from "../../components/AttackFlowSection.astro";
import atlas from "../../data/atlas-techniques.json";
import {
  getAttacks,
  href,
  repo,
  formatDate,
  roles,
  type Attack,
} from "../../lib/catalog";
import {
  present,
  evidenceTypes,
  environments,
  meaningful,
} from "../../lib/presentation";
export async function getStaticPaths() {
  return (await getAttacks()).map((attack) => ({
    params: { id: attack.id },
    props: { attack },
  }));
}
const { attack } = Astro.props as { attack: Attack };
const display = present(attack);
const simulations = simulationsFor(attack.id);
const techniques = atlas.techniques as Record<
  string,
  { name: string; url: string }
>;
const atlasMappings = attack.atlas_techniques || [];
const coverage = [...new Set(attack.magicsword_coverage || [])];
const knownRegions = attack.regions.filter((r) => meaningful(r));
const iocCount = Object.values(attack.iocs || {}).reduce(
  (sum, values) => sum + values.length,
  0,
);
---

<Layout
  title={`${display.title} — OpenAttacks`}
  description={display.summary}
  lastReviewed={attack.last_reviewed}
>
  <article class="container entry-focused">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={href("catalog/")}>Catalog</a>
      <span aria-hidden="true">/</span>
      <span>{display.title}</span>
    </nav>
    <header class="entry-heading">
      <div class="entry-evidence">
        <a class="detection-available" href="#detections">
          <Icon name="search" size={13} /> Detection queries{" "}
          <Icon name="down" size={11} />
        </a>
        {simulations.length > 0 && (
          <a class="simulation-available" href="#simulation">
            <Icon name="terminal" size={13} /> Simulation available{" "}
            <Icon name="down" size={11} />
          </a>
        )}
        <span class={`evidence-badge evidence-${display.evidence}`}>
          {evidenceTypes[display.evidence]}
        </span>
        {display.environments.filter((id) => id !== "unspecified").length >
          0 && (
          <span>
            {display.environments
              .filter((id) => id !== "unspecified")
              .map((id) => environments[id])
              .join(" · ")}
          </span>
        )}
      </div>
      <h1>{display.title}</h1>
      <p class="entry-takeaway">{display.summary}</p>
      <div class="entry-meta">
        <span>
          Reported{" "}
          <time datetime={attack.date_reported}>
            {formatDate(attack.date_reported, true)}
          </time>
          {attack.date_reported.length === 7 && " (month only)"}
        </span>
        <a href="#sources">Source: {attack.org}</a>
      </div>
      {attack.borderline_note && (
        <aside class="entry-qualification">
          <strong>Evidence qualification</strong>
          <p>{attack.borderline_note}</p>
        </aside>
      )}
    </header>
    <section class="entry-story" aria-labelledby="what-happened">
      <h2 id="what-happened">What happened</h2>
      <p>{attack.technique_summary}</p>
      {attack.ai_role_detail && <p>{attack.ai_role_detail}</p>}
      <a class="text-link" href="#sources">
        Read the original sources
      </a>
    </section>
    <AttackFlowSection
      attack={attack}
      simulation={
        simulations.length
          ? {
              stageIds: [
                ...new Set(simulations.flatMap((sim: any) => sim.stage_ids)),
              ],
              href: "#simulation",
            }
          : undefined
      }
    />
    <DetectionSection
      attack={attack}
      simulationStages={
        [...new Set(simulations.flatMap((sim: any) => sim.stage_ids))] as string[]
      }
    />
    {simulations.length > 0 && <SimulationPreview simulations={simulations} />}
    <div class="entry-supporting">
      <details class="technical-details" id="technical-details">
        <summary>
          <span>Technical details</span>
          <small>
            Tooling, impact
            {atlasMappings.length > 0 ? " & MITRE ATLAS" : ""}
          </small>
          <Icon name="down" size={15} />
        </summary>
        <div class="technical-content">
          <section id="technique">
            <h2>Attack context</h2>
            <dl class="technical-facts">
              <dt>AI's role</dt>
              <dd>{roles[attack.ai_role].label}</dd>
              {attack.ai_role_secondary && (
                <>
                  <dt>Additional role</dt>
                  <dd>{roles[attack.ai_role_secondary].label}</dd>
                </>
              )}
              {meaningful(attack.initial_access) && (
                <>
                  <dt>Initial access</dt>
                  <dd>{attack.initial_access}</dd>
                </>
              )}
            </dl>
          </section>
          {(attack.ai_tooling_and_models.length > 0 ||
            attack.other_tooling.length > 0) && (
            <section id="tooling">
              <h2>Tooling as reported</h2>
              {attack.ai_tooling_and_models.length > 0 && (
                <>
                  <h3>AI products, models and artifacts</h3>
                  <ul class="technical-tool-list">
                    {attack.ai_tooling_and_models.map((tool) => (
                      <li>{tool}</li>
                    ))}
                  </ul>
                </>
              )}
              {attack.other_tooling.length > 0 && (
                <>
                  <h3>Other tooling</h3>
                  <ul class="technical-tool-list">
                    {attack.other_tooling.map((tool) => (
                      <li>{tool}</li>
                    ))}
                  </ul>
                </>
              )}
            </section>
          )}
          {(meaningful(attack.victims_and_sectors) ||
            meaningful(attack.scale_and_metrics) ||
            knownRegions.length > 0 ||
            attack.region_notes) && (
            <section id="impact">
              <h2>Targets and reported impact</h2>
              <dl class="technical-facts">
                {meaningful(attack.victims_and_sectors) && (
                  <>
                    <dt>Targets / sectors</dt>
                    <dd>{attack.victims_and_sectors}</dd>
                  </>
                )}
                {meaningful(attack.scale_and_metrics) && (
                  <>
                    <dt>Reported scale / exposure</dt>
                    <dd>{attack.scale_and_metrics}</dd>
                  </>
                )}
                {knownRegions.length > 0 && (
                  <>
                    <dt>Target geography</dt>
                    <dd>{knownRegions.join(" · ")}</dd>
                  </>
                )}
              </dl>
              {attack.region_notes && (
                <p class="region-context-note">{attack.region_notes}</p>
              )}
            </section>
          )}
          {meaningful(attack.attribution_or_cluster) && (
            <section>
              <h2>Reported attribution</h2>
              <p>{attack.attribution_or_cluster}</p>
            </section>
          )}
          {meaningful(attack.prevention_angle) && (
            <section>
              <h2>Source defensive notes</h2>
              <p>{attack.prevention_angle}</p>
            </section>
          )}
          {atlasMappings.length > 0 && (
            <section id="atlas">
              <h2>MITRE ATLAS</h2>
              <p class="atlas-note">
                AI-specific catalog annotations based on the reported behavior;
                these are not MITRE case-study assignments.
              </p>
              <div class="atlas-mappings">
                {atlasMappings.map((mapping) => (
                  <div class="atlas-mapping">
                    <a
                      href={techniques[mapping.id].url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="mono">{mapping.id}</span>
                      <strong>{techniques[mapping.id].name}</strong>
                    </a>
                    <p>
                      {mapping.rationale}{" "}
                      <a
                        class="accent"
                        href={`#source-${
                          Math.max(
                            0,
                            attack.sources.findIndex(
                              (s) => s.url === mapping.source_urls[0],
                            ),
                          ) + 1
                        }`}
                      >
                        Source
                      </a>
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )}
          {iocCount > 0 && (
            <section>
              <h2>Indicators of compromise</h2>
              {Object.entries(attack.iocs!).map(([category, values]) => (
                <div>
                  <h3>{category}</h3>
                  <ul>
                    {values.map((value) => (
                      <li>
                        <code>{value}</code>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>
          )}
        </div>
      </details>
      <section id="sources" class="entry-sources">
        <div class="section-title">
          <h2>Sources & research credit</h2>
          <span>
            {attack.sources.length}{" "}
            {attack.sources.length === 1 ? "source" : "sources"}
          </span>
        </div>
        <p>
          Research by <strong>{attack.researcher}</strong> · {attack.org}
        </p>
        <ol class="source-list">
          {attack.sources.map((source, i) => (
            <li id={`source-${i + 1}`}>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.title ||
                  new URL(source.url).hostname.replace(/^www\./, "")}{" "}
                {source.title && (
                  <span class="source-host">
                    {new URL(source.url).hostname}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ol>
        {attack.source_notes && (
          <p class="source-notes">{attack.source_notes}</p>
        )}
        {coverage.length > 0 && (
          <p class="published-coverage">
            Published analysis:{" "}
            {coverage.map((url, i) => (
              <a href={url} target="_blank" rel="noopener noreferrer">
                MagicSword
                {coverage.length > 1 ? ` ${i + 1}` : ""}
              </a>
            ))}
          </p>
        )}
      </section>
      <details class="entry-record">
        <summary>
          Record & downloads <Icon name="down" size={13} />
        </summary>
        <dl class="technical-facts">
          <dt>Source record name</dt>
          <dd>{attack.name}</dd>
          <dt>Entry ID</dt>
          <dd class="mono">{attack.id}</dd>
          {attack.last_reviewed && (
            <>
              <dt>Catalog review</dt>
              <dd>{formatDate(attack.last_reviewed, true)}</dd>
            </>
          )}
          {attack.confidence && (
            <>
              <dt>AI-role confidence</dt>
              <dd>{attack.confidence}</dd>
            </>
          )}
          {!!attack.aliases?.length && (
            <>
              <dt>Aliases</dt>
              <dd>{attack.aliases.join(" · ")}</dd>
            </>
          )}
        </dl>
        <div class="record-links">
          <a href={href(`api/attacks/${attack.id}.json`)}>JSON</a>
          <a href={href(`api/attacks/${attack.id}.md`)}>Markdown</a>
          <a href={href(`api/defenses/${attack.id}.json`)}>Flow & hunt data</a>
          <a
            href={`${repo}/edit/main/attacks/${attack.id}.yaml`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Edit on GitHub
          </a>
          <a
            href={`${repo}/issues/new?template=correction.yml&title=${encodeURIComponent(`Correction: ${attack.name}`)}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Suggest a correction
          </a>
        </div>
      </details>
    </div>
  </article>
</Layout>

<script>
  // Preserve deep links to technical sections without expanding the whole record by default.
  function revealLinkedSection() {
    let id: string;
    try {
      id = decodeURIComponent(location.hash.slice(1));
    } catch {
      return;
    }
    if (!id) return;
    const target = document.getElementById(id);
    let ancestor = target?.parentElement;
    while (ancestor) {
      if (ancestor instanceof HTMLDetailsElement) ancestor.open = true;
      ancestor = ancestor.parentElement;
    }
    target?.scrollIntoView();
  }
  revealLinkedSection();
  window.addEventListener("hashchange", revealLinkedSection);
</script>
