---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { repo } from "../lib/catalog";

const issues = `${repo}/issues`;
const options = [
  ["Submit an attack", "template=submit-attack.yml"],
  ["Correct an entry", "template=correction.yml"],
  [
    "Suggest a catalog improvement",
    new URLSearchParams({ title: "Catalog suggestion: " }),
  ],
];
---

<Layout
  title="Suggest an update — OpenAttacks"
  description="Share an incident lead, catalog suggestion, or correction with OpenAttacks."
>
  <div class="container">
    <article class="suggestion-page">
      <h1>Suggest an update</h1>
      <p class="intro">
        Sign in to GitHub to submit a public issue. Include only information
        you can share publicly.
      </p>

      <ul class="submission-options">
        {options.map(([label, query]) => (
          <li>
            <a class="button" href={`${issues}/new?${query}`}>
              {label}
              <Icon name="arrow" size={16} />
            </a>
          </li>
        ))}
      </ul>

      <p><a class="text-link" href={issues}>Browse public issues</a></p>
      <p>
        <a class="text-link" href={`${repo}/security/advisories/new`}>
          Report an OpenAttacks vulnerability privately on GitHub
        </a>
      </p>
    </article>
  </div>
</Layout>

<style>
  .suggestion-page {
    max-width: 600px;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4.5rem) 0;
  }
  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 1.05;
  }
  .intro {
    color: var(--muted);
    margin: 0 0 1.5rem;
  }
  .submission-options {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    margin: 0 0 1.5rem;
    list-style: none;
  }
  .submission-options .button {
    justify-content: space-between;
    width: 100%;
    min-height: 48px;
    font-size: 1rem;
    white-space: normal;
  }
  .submission-options svg {
    flex: none;
    color: var(--accent);
  }
  .suggestion-page .text-link {
    display: inline;
    color: var(--accent);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
