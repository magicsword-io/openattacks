---
import Layout from "../layouts/Layout.astro";
import TimelineChart from "../components/TimelineChart.astro";
import LatestEntries from "../components/LatestEntries.astro";
import StackExplorer from "../components/StackExplorer.astro";
import AgentAccess from "../components/AgentAccess.astro";
import Icon from "../components/Icon.astro";
import { getAttacks, href } from "../lib/catalog";
const attacks = await getAttacks();
---

<Layout>
  <div class="container landing-focused">
    <section class="hero hero-observatory">
      <div class="hero-introduction">
        <div>
          <span class="eyebrow accent">AI ATTACKS · BY MAGICSWORD</span>
          <h1>
            One technology.
            <br />
            <em>Many attack paths.</em>
          </h1>
        </div>
        <div class="hero-description">
          <p class="hero-copy">
            Find the AI attack paths relevant to your team’s tools—and see what
            to review, prevent, or hunt for.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#your-stack">
              See what applies to my stack <Icon name="right" size={16} />
            </a>
            <a class="text-link" href={href("catalog/")}>
              Browse the full catalog <Icon name="arrow" size={13} />
            </a>
          </div>
        </div>
      </div>
      <TimelineChart attacks={attacks} large />
      <p class="timeline-context">
        Each dot opens a sourced entry. Counts reflect report dates and catalog
        coverage, including research; they do not measure global attack
        prevalence.
      </p>
    </section>
    <StackExplorer attacks={attacks} />
    <div data-stack-default>
      <LatestEntries attacks={attacks.slice(0, 6)} total={attacks.length} />
    </div>
    <AgentAccess />
  </div>
</Layout>
