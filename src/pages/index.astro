---
import Layout from "../layouts/Layout.astro";
import TimelineChart from "../components/TimelineChart.astro";
import LatestEntries from "../components/LatestEntries.astro";
import AgentAccess from "../components/AgentAccess.astro";
import Icon from "../components/Icon.astro";
import { getAttacks, href } from "../lib/catalog";
import { environments, present } from "../lib/presentation";
const attacks = await getAttacks();
const shortcuts = ["windows", "agents", "cloud", "development"].filter((id) =>
  attacks.some((a) => present(a).environments.includes(id)),
);
---

<Layout>
  <div class="container landing-focused">
    <section class="hero hero-observatory">
      <div class="hero-introduction">
        <div>
          <span class="eyebrow accent">AI ATTACKS · BY MAGICSWORD</span>
          <h1>
            One technology.
            <br />
            <em>Many attack paths.</em>
          </h1>
        </div>
        <div class="hero-description">
          <p class="hero-copy">
            Understand how AI fits into an attack. Follow the path, find where
            to interrupt it, and explore ways to hunt for it.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={href("catalog/")}>
              Browse {attacks.length} attack paths{" "}
              <Icon name="right" size={16} />
            </a>
            <a class="text-link" href={href("about/")}>
              How we assess the evidence <Icon name="arrow" size={13} />
            </a>
          </div>
        </div>
      </div>
      <TimelineChart attacks={attacks} large />
      <p class="timeline-context">
        Each dot opens a sourced entry. Counts reflect report dates and catalog
        coverage, including research; they do not measure global attack
        prevalence.
      </p>
    </section>
    <section
      class="environment-shortcuts"
      aria-label="Find attack paths by environment"
    >
      <span>Start with your environment</span>
      <div>
        {shortcuts.map((id) => (
          <a href={`${href("catalog/")}?environment=${id}`}>
            {environments[id]} <Icon name="right" size={12} />
          </a>
        ))}
      </div>
    </section>
    <LatestEntries attacks={attacks.slice(0, 6)} total={attacks.length} />
    <AgentAccess />
  </div>
</Layout>
