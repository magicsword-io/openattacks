---
import Layout from "../layouts/Layout.astro";
import TimelineChart from "../components/TimelineChart.astro";
import Catalog from "../components/Catalog.astro";
import AgentAccess from "../components/AgentAccess.astro";
import CommunityBanner from "../components/CommunityBanner.astro";
import Icon from "../components/Icon.astro";
import { getAttacks, roles, href, repo } from "../lib/catalog";
const attacks = await getAttacks();
const years = new Set(attacks.map((a) => a.date_reported.slice(0, 4)));
---

<Layout>
  <div class="container">
    <section class="hero hero-observatory">
      <div class="hero-introduction">
        <div>
          <h1>
            AI is changing
            <br />
            the <em>attack path.</em>
          </h1>
        </div>
        <div class="hero-description">
          <p class="hero-copy">
            How attackers actually use AI, sourced and mapped to prevention. A
            community-maintained catalog built to help defenders see the
            patterns.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#catalog">
              Explore the catalog <Icon name="right" size={16} />
            </a>
            <a
              class="text-link"
              href={`${repo}/blob/main/CONTRIBUTING.md`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Contribute an attack <Icon name="arrow" size={13} />
            </a>
          </div>
        </div>
      </div>
      <TimelineChart attacks={attacks} large />
    </section>
    <section class="overview-stats" aria-label="Catalog at a glance">
      <div class="stat">
        <span class="stat-number">{attacks.length}</span>
        <span class="stat-label">
          <strong>Documented entries</strong>Every entry has a source
        </span>
        <Icon name="book" size={22} class="stat-symbol" />
      </div>
      <div class="stat">
        <span class="stat-number">
          {Object.keys(roles).length.toString().padStart(2, "0")}
        </span>
        <span class="stat-label">
          <strong>Roles AI can play</strong>Across the attack path
        </span>
        <Icon name="layers" size={22} class="stat-symbol" />
      </div>
      <div class="stat">
        <span class="stat-number">
          {years.size.toString().padStart(2, "0")}
        </span>
        <span class="stat-label">
          <strong>Years of activity</strong>
          {[...years].sort()[0]} — {[...years].sort().at(-1)}
        </span>
        <Icon name="clock" size={22} class="stat-symbol" />
      </div>
      <div class="stat">
        <span class="stat-number">
          100<span style="font-size:.55em">%</span>
        </span>
        <span class="stat-label">
          <strong>Open & community-led</strong>Built for better defense
        </span>
        <Icon name="globe" size={22} class="stat-symbol" />
      </div>
    </section>
    <section aria-labelledby="roles-heading">
      <div class="section-title">
        <h2 id="roles-heading">Attack paths</h2>
        <span class="eyebrow">
          BROWSE BY AI ROLE <Icon name="down" size={10} />
        </span>
      </div>
      <div class="role-grid">
        {Object.entries(roles).map(([key, role]) => (
          <a
            class="role-card"
            style={`--role-color:${role.color}`}
            href={`${href("catalog/")}?role=${key}`}
            title={role.description}
          >
            <div class="role-card-top">
              <Icon name={role.icon} size={18} />
              <span>↗</span>
            </div>
            <div class="role-card-number">
              {String(attacks.filter((a) => a.ai_role === key).length).padStart(
                2,
                "0",
              )}
            </div>
            <div class="role-card-label">{role.short}</div>
          </a>
        ))}
      </div>
    </section>
    <AgentAccess />
    <Catalog attacks={attacks} home />
    <CommunityBanner />
  </div>
</Layout>
