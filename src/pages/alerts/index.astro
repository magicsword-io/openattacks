---
import IncidentAlertForm from "../../components/IncidentAlertForm.astro";
import Layout from "../../layouts/Layout.astro";
import { incidentAlertSignupAvailable } from "../../lib/incident-alert-signup";
---

<Layout
  title="Get incident alerts | OpenAttacks"
  description="Get the daily OpenAttacks email digest of newly published catalog entries."
  active="alerts"
  analytics={false}
>
  <section class="container alerts">
    <h1>Get incident alerts</h1>
    {incidentAlertSignupAvailable ? (
      <IncidentAlertForm id="incident-alert-email" />
    ) : (
      <p>Incident alert signup is currently unavailable.</p>
    )}
  </section>
</Layout>

<style>
  .alerts {
    max-width: 680px;
    padding-block: clamp(3rem, 8vw, 7rem);
  }
  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
</style>
