---
import Layout from "../layouts/Layout.astro";
import Catalog from "../components/Catalog.astro";
import { getAttacks } from "../lib/catalog";
const attacks = await getAttacks();
---

<Layout title="Attack Catalog — AI Attacks">
  <div class="container">
    <header class="page-heading">
      <span class="eyebrow">THE ATTACK CATALOG</span>
      <h1>Find the attack paths that matter to you.</h1>
      <p>
        Start with your environment. Follow the evidence, then explore the
        controls and hunts at each stage.
      </p>
    </header>
    <Catalog attacks={attacks} />
  </div>
</Layout>
