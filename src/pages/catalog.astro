---
import Layout from "../layouts/Layout.astro";
import Catalog from "../components/Catalog.astro";
import CommunityBanner from "../components/CommunityBanner.astro";
import { getAttacks } from "../lib/catalog";
const attacks = await getAttacks();
---

<Layout title="Attack Catalog — AI Attacks">
  <div class="container">
    <header class="page-heading">
      <span class="eyebrow">THE OPEN INTELLIGENCE INDEX</span>
      <h1>The evidence, in one place.</h1>
      <p>
        Explore how AI fits into real attack paths. Search the source-backed
        catalog by technique, model, region, and the role AI played.
      </p>
    </header>
    <Catalog attacks={attacks} />
    <CommunityBanner />
  </div>
</Layout>
